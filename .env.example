# ================================================================
#  Configuración del Profesor de Inglés
#  Copia este archivo como ".env" y llena los datos.
# ================================================================

# Nombre de la alumna y de la profesora
NOMBRE_ALUMNA=Katerin
NOMBRE_PROFESORA=Lucía

# ---------------- Cerebro (la IA que enseña) ----------------
# "anthropic" = Claude en la nube (mejor calidad, cuesta centavos por clase)
# "ollama"    = IA local en tu computador (gratis, necesita buen PC)
PROVEEDOR_IA=anthropic

# Si usas Claude: crea la clave en https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Más barato: claude-sonnet-5-5  |  Aún más barato: claude-haiku-4-5

# Si usas Ollama (local): https://ollama.com  ->  ollama pull gemma3:12b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# ---------------- Voz ----------------
# "edge"      = voces neuronales de Microsoft (muy naturales, gratis, necesita internet)
# "kokoro"    = voz 100% local (instalar aparte: pip install kokoro soundfile)
# "navegador" = la voz que traiga el navegador (la más robótica)
MOTOR_VOZ=edge

# Voces de "edge". Salomé es colombiana :)
VOZ_ESPANOL=es-CO-SalomeNeural
VOZ_INGLES=en-US-JennyNeural
# Velocidad del inglés (negativo = más despacio)
VELOCIDAD_INGLES=-15%

# Voces de "kokoro"
KOKORO_VOZ_ESPANOL=ef_dora
KOKORO_VOZ_INGLES=af_heart

PUERTO=8000
